{
  "name": "Impact Health",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "build:staging": "ng build --configuration staging",
    "build:analyze": "ng build --configuration production --stats-json && npx webpack-bundle-analyzer dist/vitality/stats.json",
    "build:optimized": "ng build --configuration production --optimization",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:coverage": "ng test --code-coverage",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "performance:audit": "lighthouse http://localhost:4200 --output=json --output-path=./lighthouse-report.json",
    "performance:budget": "ng build --configuration production && npx bundle-buddy dist/vitality/stats.json",
    "memory:profile": "node --inspect-brk ./node_modules/@angular/cli/bin/ng serve",
    "clean": "rimraf dist .angular node_modules/.cache",
    "prebuild": "npm run clean"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.3.0",
    "@angular/common": "^17.3.0",
    "@angular/compiler": "^17.3.0",
    "@angular/core": "^17.3.0",
    "@angular/forms": "^17.3.0",
    "@angular/platform-browser": "^17.3.0",
    "@angular/platform-browser-dynamic": "^17.3.0",
    "@angular/platform-server": "^17.3.0",
    "@angular/router": "^17.3.0",
    "@ctrl/ngx-emoji-mart": "^9.2.0",
    "@ctrl/tinycolor": "^4.1.0",
    "@fullcalendar/angular": "^6.1.15",
    "@fullcalendar/core": "^6.1.15",
    "@fullcalendar/daygrid": "^6.1.15",
    "@fullcalendar/interaction": "^6.1.15",
    "@fullcalendar/list": "^6.1.15",
    "@fullcalendar/timegrid": "^6.1.15",
    "@fullscript/fullscript-js": "^3.2.0",
    "@microsoft/signalr": "^8.0.7",
    "@opentok/client": "^2.30.2",
    "@stripe/connect-js": "^3.3.33",
    "@stripe/stripe-js": "^3.5.0",
    "@types/jwt-decode": "^2.2.1",
    "autoprefixer": "^10.4.20",
    "echarts": "^5.6.0",
    "express": "^4.18.2",
    "jwt-decode": "^4.0.0",
    "less": "^4.2.1",
    "less-loader": "^12.2.0",
    "ng-zorro-antd": "^17.4.1",
    "ngx-echarts": "^19.0.0",
    "ngx-quill": "^25.3.3",
    "ngx-stripe": "^17.0.0",
    "ngx-ui-loader": "^17.0.0",
    "pdfjs-dist": "^4.10.38",
    "postcss": "^8.4.47",
    "quill": "^2.0.3",
    "rxjs": "~7.8.0",
    "signature_pad": "^5.1.1",
    "tailwindcss": "^3.4.13",
    "tslib": "^2.3.0",
    "xlsx": "^0.18.5",
    "zone.js": "~0.14.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.8",
    "@angular/cli": "^17.3.8",
    "@angular/compiler-cli": "^17.3.0",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^18.18.0",
    "bundle-buddy": "^0.2.2",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "lighthouse": "^11.6.0",
    "rimraf": "^5.0.5",
    "typescript": "~5.4.2",
    "webpack-bundle-analyzer": "^4.10.1"
  }
}
