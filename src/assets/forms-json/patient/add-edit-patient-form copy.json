{
    "title": "Patient",
    "primaryId": "patientId",
    "rows": [
      {
        "class": "grid grid-cols-2 gap-2 mb-2",
        "fields": [
          {
            "type": "text",
            "label": "First Name",
            "name": "firstName",
            "placeholder": "Enter First Name",
            "class": "col-span-1",
            "validations": { "required": true }
          },
          {
            "type": "text",
            "label": "Last Name",
            "name": "lastName",
            "placeholder": "Enter Last Name",
            "class": "col-span-1",
            "validations": { "required": true }
          },
          {
            "type": "email",
            "label": "Email",
            "name": "email",
            "placeholder": "Enter Email",
            "class": "col-span-2",
            "validations": { "required": true }
          },
          {
            "type": "select",
            "label": "Sex Assigned at Birth",
            "name": "gender",
            "placeholder": "Select Your Sex",
            "class": "col-span-1",
            "options": [
              { "label": "Male", "value": "Male" },
              { "label": "Female", "value": "Female" }
            ],
            "validations": { "required": true }
          },
          {
            "type": "date",
            "label": "Birthdate",
            "name": "dob",
            "placeholder": "Select Date of Birth",
            "class": "col-span-1",
            "validations": { "required": true }
          }
        ]
      },
      {
        "class": "grid grid-cols-1 gap-2 mb-2",
        "fields": [
          {
            "type": "text",
            "label": "Address",
            "name": "address",
            "placeholder": "Enter Address",
            "class": "col-span-1",
            "validations": { "required": true }
          },
          {
            "type": "text",
            "label": "Street",
            "name": "street",
            "placeholder": "Enter Street",
            "class": "col-span-1",
            "validations": { "required": true }
          }
        ]
      },
      {
        "class": "grid grid-cols-2 gap-2 mb-2",
        "fields": [
          {
            "type": "select",
            "label": "City",
            "name": "cityId",
            "placeholder": "Select City",
            "class": "col-span-1",
            "labelKey": ["name"],
            "valueKey": "id",
            "fetchUrl": "Dropdowns/getAllUSCities",
            "validations": { "required": true }
          },
          {
            "type": "select",
            "label": "State",
            "name": "stateId",
            "placeholder": "Select State",
            "class": "col-span-1",
            "dependsOn": ["cityId"],
            "labelKey": ["name"],
            "valueKey": "id",
            "fetchUrl": "Dropdowns/getUSStatesByCityId?Id={cityId}",
            "validations": { "required": true }
          }
        ]
      },
      {
        "class": "grid grid-cols-2 gap-2 mb-2",
        "fields": [
          {
            "type": "tel",
            "label": "Zip Code",
            "name": "zipcode",
            "placeholder": "Enter Zip Code",
            "class": "col-span-1",
            "validations": { "required": true }
          },
          {
            "type": "tel",
            "label": "Phone number",
            "name": "phone",
            "placeholder": "(###) ###-####",
            "class": "col-span-1",
            "validations": { "required": true }
          }
        ]
      },
      {
        "class": "grid grid-cols-2 gap-2 mb-2",
        "fields": [
          {
            "type": "file-drag",
            "label": "Upload Your Image",
            "name": "patientPicture",
            "placeholder": "",
            "class": "col-span-1",
            "fileAllowed": "single",
            "validations": {
              "required": true
            }
          },
          {
            "type": "file-drag",
            "label": "Upload ID Image",
            "name": "idPicture",
            "placeholder": "",
            "class": "col-span-1",
            "fileAllowed": "single",
            "validations": {
              "required": true
            }
          }
        ]
      }
    ]
  }
