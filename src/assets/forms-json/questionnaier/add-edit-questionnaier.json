{
    "title": "Questionnaire Form",
    "primaryId": "questionnaireId",
    "rows": [
        {
            "class": "grid grid-cols-1 gap-2 mb-2",
            "fields": [
                {
                    "type": "text",
                    "label": "Questionnaire Name",
                    "name": "questionnaireName",
                    "placeholder": "Enter Questionnaire Name",
                    "class": "col-span-full",
                    "validations": {
                        "required": true
                    }
                },
                {
                    "type": "multi-select",
                    "label": "Categories",
                    "name": "categoryId",
                    "placeholder": "Select Categories",
                    "class": "col-span-full",
                    "validations": {
                        "required": true
                    },
                    "labelKey": ["categoryName"],
                    "valueKey": "categoryId",
                    "fetchUrl": "DropDowns/getAllCategories?QuestionnaireId={primaryId}"
                }
            ]
        }
    ]
}
